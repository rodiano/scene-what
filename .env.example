PORT=3000
# Maks antal spillere pr. session
MAX_PLAYERS=6
# Antal stempler fra festivalpladsens stande, før Scenevagten lukker op (overskriver config/festival.json)
STAMPS_REQUIRED=3
# Hvor længe en inaktiv session gemmes (timer)
SESSION_TTL_HOURS=12
# Maks antal samtidige sessioner på serveren
MAX_SESSIONS=500
SKIP_AFTER_WRONG=5
# Eksterne filer (kan ligge uden for projektet; genindlæses automatisk ved ændringer)
FESTIVAL_CONFIG=config/festival.json
QUESTIONS_CONFIG=config/questions.json
MEDIA_DIR=media
ADMIN_KEY=
